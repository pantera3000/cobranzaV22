# ===================================
# Configuración de Django - CobranzaV22
# ===================================
# Este es un archivo de ejemplo. Copia este archivo como .env y configura tus valores.

# Modo de depuración (True para desarrollo, False para producción)
DEBUG=False

# Clave secreta de Django (genera una nueva para producción)
# Puedes generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-clave-secreta-aqui-generala-nueva

# Hosts permitidos (separados por coma, sin espacios)
# Ejemplo: ALLOWED_HOSTS=nativacobros.pythonanywhere.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (opcional, por ahora usamos SQLite por defecto)
# DATABASE_URL=sqlite:///db.sqlite3
